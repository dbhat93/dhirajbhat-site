---
import '../styles/global.css';

interface Props {
  company: string;
  role: string;
  years: string;
  prev?: { slug: string; name: string };
  next?: { slug: string; name: string };
}

const { company, role, years, prev, next } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta property="og:title" content={`${company} - Dhiraj Bhat`} />
    <meta property="og:description" content="Product manager. Builder. Fraud nerd. Seven years at the intersection of financial crime and AI." />
    <meta property="og:url" content="https://dhirajbhat.com" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={`${company} - Dhiraj Bhat`} />
    <meta name="twitter:description" content="Product manager. Builder. Fraud nerd." />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{company} - Dhiraj Bhat</title>
  </head>
  <body>
    <main class="company-page">

      <nav class="company-nav">
        <a href="/" class="back-link">Dhiraj Bhat</a>
      </nav>

      <header class="company-header">
        <h1>{company}</h1>
        <p class="company-role">{role}</p>
        <p class="company-years">{years}</p>
      </header>

      <div class="company-prevnext">
        {prev && <a href={`/company/${prev.slug}/`} class="prevnext-link">← {prev.name}</a>}
        {next && <a href={`/company/${next.slug}/`} class="prevnext-link prevnext-right">Next: {next.name} →</a>}
      </div>

      <div class="company-content">
        <slot />
      </div>

    </main>

    <footer>
      <div class="footer-links">
        <a href="https://www.linkedin.com/in/dhiraj-bhat" target="_blank" rel="noopener">LinkedIn</a>
        <a href="https://github.com/dbhat93" target="_blank" rel="noopener">GitHub</a>
        <a href="https://dhirajbhat.medium.com" target="_blank" rel="noopener">Medium</a>
        <a href="mailto:dhirajbhat93@gmail.com">Email</a>
      </div>
    </footer>

  </body>
</html>
